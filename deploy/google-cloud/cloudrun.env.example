# Variables no secretas de ejecución para Google Cloud Run.
# Los valores reales se deben configurar en Cloud Run o Secret Manager,
# nunca copiando unified-mcp/.env a la imagen.

MCP_TRANSPORT=streamable-http
PORT=8080

# Debe proceder de Secret Manager. Protege /mcp frente al acceso directo.
MCP_AUTH_TOKEN=

# Activación de plataformas. Desactiva las que aún no quieras llevar a Cloud Run.
ENABLE_LINKEDIN=true
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_THREADS=true
ENABLE_WORDPRESS=true
ENABLE_X=true
ENABLE_FB_SHARE=true
ENABLE_IMAGE_GEN=true

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_TOKEN_EXPIRY=
LINKEDIN_PERSON_URN=

# Facebook Page
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_TOKEN_EXPIRY=
FACEBOOK_PAGE_ID=

# Instagram Business
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# WordPress.com
WP_CLIENT_ID=
WP_CLIENT_SECRET=
WP_ACCESS_TOKEN=
WP_SITE_ID=

# X/Twitter vía Twikit
X_USERNAME=
X_PASSWORD=
X_EMAIL=

# generate_image usa, en orden, Cloudflare Workers AI -> Hugging Face
# FLUX.1-schnell -> Pollinations.ai. Los tres son gratuitos y no requieren
# credenciales; solo hace falta cambiar la URL si mueves el Worker.
CLOUDFLARE_IMAGE_WORKER_URL=https://image-burn.danilo-testoni.workers.dev

# Webhook opcional de notificación
NOTIFY_WEBHOOK_URL=
