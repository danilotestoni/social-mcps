# Keep credentials, generated media and local/test artifacts out of the source upload.
.gcloudignore
.git/
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
logs/
generated/
tests/
auth/**/*.json
auth/**/*.token
auth/**/*.session
auth/**/*.sqlite
auth/**/*.db
