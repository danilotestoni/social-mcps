# Variables no secretas de ejecución para Google Cloud Run.
# Los valores reales se deben configurar en Cloud Run o Secret Manager,
# nunca copiando unified-mcp/.env a la imagen.

MCP_TRANSPORT=streamable-http
PORT=8080

# Activación de plataformas. Desactiva las que aún no quieras llevar a Cloud Run.
ENABLE_LINKEDIN=true
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_THREADS=true
ENABLE_WORDPRESS=true
ENABLE_X=true
ENABLE_FB_SHARE=true
ENABLE_IMAGE_GEN=true

# Todas las credenciales (MCP_AUTH_TOKEN, LinkedIn, Facebook, Instagram,
# Threads, WordPress, X) viven en UN único secreto de Secret Manager,
# `social-mcps-credentials`, como JSON: {"MCP_AUTH_TOKEN": "...",
# "LINKEDIN_CLIENT_ID": "...", ...}. Cloud Run lo inyecta entero como la
# variable SOCIAL_MCPS_SECRETS_JSON (ver --update-secrets en el deploy);
# core/config.py::load_consolidated_secrets() lo desempaqueta a variables de
# entorno individuales al arrancar. Antes había 29 secretos separados — se
# consolidaron en uno solo para no pasarse del free tier de Secret Manager
# (6 versiones activas). Ver rotate-secret.sh para cómo rotar un campo.
SOCIAL_MCPS_SECRETS_JSON=

# generate_image usa, en orden, Cloudflare Workers AI -> Hugging Face
# FLUX.1-schnell -> Pollinations.ai. Los tres son gratuitos y no requieren
# credenciales; solo hace falta cambiar la URL si mueves el Worker.
CLOUDFLARE_IMAGE_WORKER_URL=https://image-burn.danilo-testoni.workers.dev

# upload_temp_image/delete_temp_image: bucket privado para imágenes que
# llegan adjuntas/creadas en el chat (no generadas por generate_image).
GCS_TEMP_BUCKET=social-mcps-temp-images

# queue_list/get/create/update/mark_published/mark_discarded/archive_week:
# cola compartida Claude/ChatGPT del pipeline de noticias. Bucket persistente
# (versioning, sin lifecycle de borrado) — no confundir con GCS_TEMP_BUCKET.
QUEUE_GCS_BUCKET=social-mcps-queue
# URL pública canónica del MCP — usada para construir las URLs
# /temp-image/<token> que sirven de proxy hacia el bucket privado
# (no se usan signed URLs nativas de GCS: el fetcher de Instagram no las
# procesa correctamente, ver clients/gcs_temp_storage_client.py).
PUBLIC_BASE_URL=https://unified-mcp.adasnova.com

# Webhook opcional de notificación
NOTIFY_WEBHOOK_URL=
